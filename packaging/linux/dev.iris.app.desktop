[Desktop Entry]
Type=Application
Name=iris
GenericName=Screenshot & Screen Recorder
Comment=Screenshot and screen-recording utility
Exec=iris
Icon=iris
Terminal=false
Categories=Utility;
StartupWMClass=dev.iris.app
StartupNotify=true
Keywords=screenshot;screen;capture;recorder;snip;record;video;
Actions=Capture;Record;Library;Settings;

[Desktop Action Capture]
Name=New Screenshot
Exec=iris --capture --from-menu
Icon=iris

[Desktop Action Record]
Name=Record Window
Exec=iris --record-window --from-menu
Icon=iris

[Desktop Action Library]
Name=Library
Exec=iris --library --from-menu
Icon=iris

[Desktop Action Settings]
Name=Settings
Exec=iris --settings --from-menu
Icon=iris
