#!/bin/sh
# AppRun: the entry point of the iris AppImage (packaging/CONTRACT.md).
#
# The AppImage runtime runs this from the mounted AppDir with $APPIMAGE
# and $APPDIR set. iris bundles no libraries, programs or data, so it
# runs with the environment it was given: iris and every program it
# starts keep the caller's LD_LIBRARY_PATH, PATH and XDG_DATA_DIRS.
#
# With no arguments iris starts the background daemon; --home opens the
# UI.
exec "$(dirname "$(readlink -f "$0")")/usr/bin/iris" "$@"
