#!/bin/sh
# AppRun: the entry point of the iris AppImage (packaging/CONTRACT.md).
#
# The AppImage runtime runs this from the mounted AppDir with $APPIMAGE
# and $APPDIR set. iris resolves its bundled FFmpeg beside this
# executable, so AppRun does not add the mount to LD_LIBRARY_PATH, PATH
# or XDG_DATA_DIRS. iris and every program it starts keep the caller's
# environment; no path refers to a mount that exits with iris.
#
# With no arguments iris starts and opens its home window; --background
# starts iris with no window.
exec "$(dirname "$(readlink -f "$0")")/usr/bin/iris" "$@"
