#!/bin/sh
set -e

# AppRun — Entry point for the iris AppImage bundle
# References: packaging/CONTRACT.md

# Determine AppDir base path
HERE="$(dirname "$(readlink -f "$0")")"
export APPDIR="${HERE}"

# Set up environment for bundled or system libraries and resources
export PATH="${APPDIR}/usr/bin:${PATH}"
export LD_LIBRARY_PATH="${APPDIR}/usr/lib:${APPDIR}/usr/lib/x86_64-linux-gnu:${LD_LIBRARY_PATH:-}"
export XDG_DATA_DIRS="${APPDIR}/usr/share:${XDG_DATA_DIRS:-/usr/local/share:/usr/share}"

# Forward all arguments directly to the iris binary
# (Running without arguments starts the background daemon; --home opens the UI)
exec "${APPDIR}/usr/bin/iris" "$@"
