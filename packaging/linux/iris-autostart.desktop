[Desktop Entry]
Type=Application
Name=iris
GenericName=Screenshot & Screen Recorder
Comment=Start iris at login with its tray icon and global hotkeys
Exec=iris --background
Icon=iris
Terminal=false
Categories=Utility;
X-GNOME-Autostart-enabled=true
X-GNOME-Autostart-Delay=2
X-KDE-autostart-after=panel
StartupNotify=false
NoDisplay=true
